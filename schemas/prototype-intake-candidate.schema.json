{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Workspace Intake Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "candidate_ref", "candidate_digest", "content"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "prototype-intake-candidate"},
    "candidate_ref": {"type": "string", "pattern": "^record://intake-candidates/[0-9a-f]{64}$"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "source", "baseline", "evidence_refs", "authority"],
      "properties": {
        "request": {"$ref": "#/$defs/input"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_ref", "record_version", "record_digest", "tree", "name", "lifecycle", "owner", "visibility_tier", "data_mode", "mutation_boundary", "linked_records", "delivery_packet_ref"],
          "properties": {
            "record_ref": {"type": "string", "pattern": "^record://prototypes/[a-z0-9]+(-[a-z0-9]+)*$"},
            "record_version": {"$ref": "#/$defs/commit"},
            "record_digest": {"$ref": "#/$defs/digest"},
            "tree": {"$ref": "#/$defs/commit"},
            "name": {"$ref": "#/$defs/text"},
            "lifecycle": {"enum": ["baseline-approved", "graduating"]},
            "owner": {"$ref": "#/$defs/text"},
            "visibility_tier": {"enum": ["private-internal", "operator-review", "client-review", "public-demo"]},
            "data_mode": {"enum": ["mock", "synthetic", "real-readonly", "real-mutable"]},
            "mutation_boundary": {"enum": ["none", "read-only", "prototype-local", "external-sandbox", "real-system"]},
            "linked_records": {"type": "array", "items": {"type": "object"}},
            "delivery_packet_ref": {"type": ["string", "null"], "pattern": "^record://delivery-packets/[a-z0-9]+(-[a-z0-9]+)*$"}
          }
        },
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["record_ref", "record_digest"],
          "properties": {
            "record_ref": {"type": "string", "pattern": "^record://design-baselines/[a-z0-9]+(-[a-z0-9]+)*$"},
            "record_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority": {"const": "source-candidate-only"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "prototype_id", "source_revision", "suggested_target", "rationale"],
      "properties": {
        "schema_version": {"const": 1},
        "prototype_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "source_revision": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "ref", "base_commit", "head_commit"],
          "properties": {
            "repository": {"const": "workspace-prototype-studio"},
            "ref": {"type": "string", "maxLength": 512, "pattern": "^refs/(heads|remotes)/[a-zA-Z0-9._/-]+$"},
            "base_commit": {"$ref": "#/$defs/commit"},
            "head_commit": {"$ref": "#/$defs/commit"}
          }
        },
        "suggested_target": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["repo", "product", "component"]},
            "name": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          }
        },
        "rationale": {"$ref": "#/$defs/text"}
      }
    }
  }
}
