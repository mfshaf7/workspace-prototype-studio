{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/prototype-preview-projection.schema.json",
  "title": "Prototype Preview Runtime safe projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "prototype_id",
    "runtime_state",
    "maturity_claim",
    "profile_digest",
    "source_digest",
    "source_revision",
    "boundary",
    "endpoint",
    "instance_id",
    "latest_receipt",
    "operator_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string"},
    "prototype_id": {"type": "string"},
    "runtime_state": {"enum": ["stopped", "running", "stale"]},
    "maturity_claim": {"const": "prototype-preview-only"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "boundary": {"type": "object"},
    "endpoint": {"type": ["string", "null"]},
    "instance_id": {"type": ["string", "null"]},
    "latest_receipt": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "digest"],
          "properties": {
            "ref": {"type": "string"},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "operator_actions": {
      "type": "array",
      "items": {"enum": ["start", "status", "restart", "stop", "proof"]},
      "uniqueItems": true
    }
  }
}
