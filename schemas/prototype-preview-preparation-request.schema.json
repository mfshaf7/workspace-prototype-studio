{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only Prototype Preview owner preparation request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "prototype_id", "source_revision", "operator", "port", "support_profile", "runtime_activation", "ttl_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "prototype_id": {"type": "string", "pattern": "^prototype:[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 256},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operator": {
      "type": "object", "additionalProperties": false, "required": ["id", "decision_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "decision_ref": {"type": "string", "pattern": "^record://[A-Za-z0-9._:/-]+$", "maxLength": 512}
      }
    },
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "support_profile": {"enum": ["interactive", "unattended"]},
    "runtime_activation": {"type": "boolean"},
    "ttl_seconds": {"type": "integer", "minimum": 300, "maximum": 86400}
  }
}
