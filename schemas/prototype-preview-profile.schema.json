{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/prototype-preview-profile.schema.json",
  "title": "Prototype Preview Runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "prototype_id",
    "status",
    "support_profile",
    "preview_mode",
    "runtime_activation",
    "runtime",
    "boundary",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "prototype_id": {"type": "string", "pattern": "^prototype:[a-z0-9][a-z0-9-]+$"},
    "status": {"enum": ["draft", "active", "suspended", "retired"]},
    "support_profile": {"enum": ["interactive", "unattended"]},
    "preview_mode": {"const": "static"},
    "runtime_activation": {"type": "boolean"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_host", "port", "source_root", "health_path"],
      "properties": {
        "bind_host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "source_root": {"type": "string", "pattern": "^prototypes/[a-z0-9][a-z0-9-]+(?:/[A-Za-z0-9._-]+)*$"},
        "health_path": {"const": "/__preview/health"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_tier",
        "data_mode",
        "mutation_boundary",
        "persistence_model",
        "public_ingress",
        "external_network"
      ],
      "properties": {
        "visibility_tier": {"enum": ["private-internal", "operator-review"]},
        "data_mode": {"enum": ["mock", "synthetic"]},
        "mutation_boundary": {"const": "none"},
        "persistence_model": {"const": "runtime-metadata-only"},
        "public_ingress": {"const": false},
        "external_network": {"const": false}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_owner", "ttl_seconds", "retirement_rule", "promotion_path"],
      "properties": {
        "cleanup_owner": {"const": "Workspace Prototype Studio"},
        "ttl_seconds": {"type": "integer", "minimum": 300, "maximum": 86400},
        "retirement_rule": {"type": "string", "minLength": 20},
        "promotion_path": {"type": "string", "minLength": 20}
      }
    }
  }
}
