{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Baseline Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prototype_id",
    "baseline_id",
    "approved_on",
    "approved_by",
    "decision",
    "source_refs",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "prototype_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "approved_on": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "decision": { "enum": ["approved", "rejected", "superseded"] },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "accepted_summary": {
      "type": "string",
      "minLength": 1
    },
    "excluded_summary": {
      "type": "string",
      "minLength": 1
    },
    "missing_evidence_disposition": {
      "type": "string",
      "minLength": 1
    },
    "issue_and_risk_disposition": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "art_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^openproject://work_packages/[0-9]+$"
      }
    },
    "security_review_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
