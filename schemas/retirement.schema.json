{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Retirement Record",
  "type": "object",
  "required": [
    "schema_version",
    "prototype_id",
    "retirement_id",
    "retired_on",
    "retired_by",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "reason": {
      "enum": ["superseded", "duplicate", "not-viable", "graduated", "cancelled"]
    }
  }
}

